+      return wsBorsh.encodeEnvelope(
+        wsBorsh.KIND_CANONICAL_COMMAND,
+        wsBorsh.encodeCanonicalCommandPayload({
+          SetPaneSubscriptions: {
+            generation,
+            activePanes: value.activePanes,
+            hotPanes: value.hotPanes,
+          },
+        }),
+        env.seq
+      );
+    } catch {
+      return bytes;
+    }
+  }
