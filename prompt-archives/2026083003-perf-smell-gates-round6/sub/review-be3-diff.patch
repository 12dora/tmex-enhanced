+function captureSql(fn: () => void): string[] {
+  const db = getSqliteClient();
+  const orig = db.prepare.bind(db);
+  const sqls: string[] = [];
+  db.prepare = ((sql: string) => {
+    sqls.push(sql);
+    return orig(sql);
+  }) as typeof db.prepare;
