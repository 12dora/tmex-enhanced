+      deviceId: 'watch-upsert-device',
+      paneId: '%2',
+      triggerType: 'match',
+      pattern: 'x',
+    });
+
+    const sqls = captureSql(() => {
+      const row = upsertWatchRuleState(rule.id, { lastValue: 'keep' });
+      expect(row.lastValue).toBe('keep');
+    });
+
+    expect(sqls.some((sql) => /^\s*select\b/i.test(sql))).toBe(true);
+  });
+});
