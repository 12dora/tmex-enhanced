+async function enrollOnLocalHub(
+  ctx: LocalAuthContext,
+  userId: string,
+  enrollment: Awaited<ReturnType<typeof createEnrollment>>,
+  now: number,
+  ttlMs: number
+): Promise<string | undefined> {
