+  useEffect(() => {
+    if (pending.size === 0) return;
+    const snapshot = createDeviceConnectionSnapshot(intentionallyDisconnected, slices);
+    const now = Date.now();
+    const timers: ReturnType<typeof setTimeout>[] = [];
+    for (const [deviceId, request] of pending) {
+      const settled = deriveSettledConnectionStatus(deviceId, snapshot);
+      const delay = pendingSettleDelay(request, settled, now);
+      if (delay === 0) pendingStore.settle(deviceId);
+      else timers.push(setTimeout(() => pendingStore.settle(deviceId), delay));
+    }
+    return () => {
+      for (const timer of timers) clearTimeout(timer);
+    };
+  }, [pendingStore, pending, intentionallyDisconnected, slices]);
