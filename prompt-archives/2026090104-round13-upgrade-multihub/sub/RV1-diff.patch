+    const settled: string[] = [];
+    const release = new Map<string, () => void>();
+    const run = (node: NodeRow, outcome: UpgradeRunOutcome = 'done') => {
+      started.push(node.name);
+      return new Promise<UpgradeRunOutcome>((resolve) => {
+        release.set(node.name, () => {
