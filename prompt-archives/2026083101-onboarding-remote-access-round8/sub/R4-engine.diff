+
+  test('passkey 用户不自动签，只把 pending 标成「证书已到」等手动确认', async () => {
+    const { pending, candidate } = await fixture('e-5');
+    rememberSigner({ kind: 'passkey', credentialId: 'cred-1' }, NOW);
+    const spy = apiSpy({ ok: true, hubAck: true });
