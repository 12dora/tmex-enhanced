+  });
+
+  test('证书对不上 pending 时按 id 记下提示 key', async () => {
+    const { pending, candidate } = await fixture('e-6');
+    const spy = apiSpy({ ok: true, hubAck: true });
+    addPendingEnrollment(pending);
+    const off = registerAdmitContext(context(spy.api));
